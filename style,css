.avatar {
    position: relative;
    z-index: 1;
    width: 180px;
    height: 180px;
    margin: 75px auto 40px;
    border-radius: 50%;
    overflow: hidden;

    border: 3px solid var(--accent);
    background: #0b0d10;

    box-shadow:
        0 0 25px rgba(166, 255, 77, 0.25),
        0 0 60px rgba(109, 99, 255, 0.25);

    transition: transform 0.4s ease, box-shadow 0.4s ease;
}

.avatar img {
    width: 100%;
    height: 100%;
    display: block;

    object-fit: cover;
    object-position: center;

    border-radius: 50%;
}

.avatar:hover {
    transform: scale(1.06);
    box-shadow:
        0 0 35px rgba(166, 255, 77, 0.45),
        0 0 80px rgba(109, 99, 255, 0.35);
}
